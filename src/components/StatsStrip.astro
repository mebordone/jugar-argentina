---
import { listaHrefByStatKey } from "../lib/listas";
import { sitePath } from "../lib/links";

type Props = {
  stats: {
    total: number;
    candidatos: number;
    descartados: number;
    vinculos: {
      escenario: number;
      protagonista: number;
      deporte: number;
    };
  };
};

const { stats } = Astro.props;

const trackingItems = [
  {
    count: stats.total + stats.candidatos + stats.descartados,
    label: "relevados",
    href: "/curaduria",
  },
  {
    count: stats.total,
    label: "aceptados",
    href: listaHrefByStatKey.total,
  },
  {
    count: stats.candidatos,
    label: "en revisión",
    href: listaHrefByStatKey.candidatos,
  },
  {
    count: stats.descartados,
    label: "descartes explicados",
    href: listaHrefByStatKey.descartados,
  },
];

const linkItems = [
  {
    count: stats.vinculos.escenario,
    label: "con escenario",
    href: listaHrefByStatKey.escenario,
  },
  {
    count: stats.vinculos.protagonista,
    label: "con protagonista",
    href: listaHrefByStatKey.protagonista,
  },
  {
    count: stats.vinculos.deporte,
    label: "con deporte",
    href: listaHrefByStatKey.deporte,
  },
];
---

<section class="stats-strip" aria-label="Estadísticas de la base">
  <div class="stats-strip-group stats-strip-tracking" aria-label="Seguimiento editorial">
    {
      trackingItems.map((item) => (
        <a class="stats-strip-link" href={sitePath(item.href)}>
          <strong>{item.count}</strong>
          <span>{item.label}</span>
        </a>
      ))
    }
  </div>
  <div class="stats-strip-group stats-strip-links" aria-label="Vínculos argentinos">
    {
      linkItems.map((item) => (
        <a class="stats-strip-link" href={sitePath(item.href)}>
          <strong>{item.count}</strong>
          <span>{item.label}</span>
        </a>
      ))
    }
  </div>
</section>
